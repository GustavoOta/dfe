# Copie para .env (NUNCA commitado) e preencha para rodar a camada de testes `sefaz-live`.
# Sem estas variáveis, os testes gated são ignorados (skip), não falham.
# Caminho com `/` (D:/pasta/cert.pfx) ou entre aspas simples: sem aspas, o `\` é escape e o
# arquivo inteiro deixa de ser lido. No WSL o mesmo caminho vira /mnt/d/... sozinho.
DFE_TEST_CERT_PATH=./cert_homologacao.pfx
DFE_TEST_CERT_PASS=
DFE_TEST_CNPJ=
DFE_TEST_UF=SP
# Emitente para o ciclo de emissão (live_ciclo_nfe_55_homologacao) e a inutilização. Sem IE e
# código do município esses dois testes são pulados. Valores com espaço vão entre aspas simples.
DFE_TEST_IE=
DFE_TEST_CRT=1
DFE_TEST_RAZAO='RAZAO SOCIAL DO TITULAR'
DFE_TEST_LOGRADOURO='RUA EXEMPLO'
DFE_TEST_NUMERO=100
DFE_TEST_COMPLEMENTO=
DFE_TEST_BAIRRO=CENTRO
DFE_TEST_COD_MUNICIPIO=3550308
DFE_TEST_MUNICIPIO='SAO PAULO'
DFE_TEST_CEP=01001000
# Série exclusiva dos testes; o número sai do relógio a cada execução (nunca repete).
DFE_TEST_SERIE=99
# CSC de HOMOLOGAÇÃO da NFC-e (live_ciclo_nfce_65_homologacao). Sem eles o teste é pulado.
# O ID pode ir como o portal mostra (000001): a crate tira os zeros no QR Code.
DFE_TEST_ID_CSC=
DFE_TEST_CSC=
# O ambiente NÃO é configurável: todo teste roda em homologação (tests/common::HOMOLOGACAO).
